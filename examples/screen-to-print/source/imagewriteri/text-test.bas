1010 FOR R = 0 TO 2:S = 32 + R * 32:F = S + 31: IF F > 126 THEN F = 126
1020 L$ = "": FOR I = S TO F:L$ = L$ + CHR$(I): NEXT I
1030 PRINT L$
1040 NEXT R
1050 RETURN
2400 REM == OVERSTRIKE W$ ONCE MORE ==
2410 FOR I = 1 TO LEN(W$): PRINT CHR$(8);: NEXT I: PRINT W$;: RETURN
