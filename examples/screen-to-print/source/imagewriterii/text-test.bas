10 REM ===== IMAGEWRITER II - MERGED FEATURE TEST =====
20 REM COUT MATRIX (FONTS X ATTRS X PITCHES) + MOUSETEXT
30 REM + COLOUR BANDS, THEN CUSTOM DOWNLOADED-FONT SECTION
40 REM VIA DIRECT-ACIA POKE (49320 = $C0A8, SSC SLOT 2).
50 E$ = CHR$ (27):Q$ = CHR$ (34):D$ = CHR$ (4)
55 A = 49320: REM SSC SLOT2 ACIA TX ($C0A8)
60 S$ = "Sphinx quartz JUDGE 0123456789"
70 PRINT D$;"PR#2"
80 PRINT E$;"c";: REM SOFT RESET TO DEFAULTS
90 GOSUB 9000: REM NORMALISE
100 PRINT E$;"a0";E$;"!";"IMAGEWRITER II - MERGED FEATURE TEST";E$;Q$
110 PRINT : PRINT
120 REM ====== BLOCK A: FONT x ATTRIBUTE MATRIX ======
130 REM ---- A1. DRAFT (a1) - RESTRICTED SET ----
140 T$ = "A1. DRAFT  (ESC a1) - restricted":  GOSUB 9100
150 PRINT E$;"a1";: GOSUB 1000
160 PRINT E$;"a1";: GOSUB 2000
170 PRINT "(bold/half/script/dblw/prop -> force CORR; see A2)"
180 REM ---- A2. CORRESPONDENCE (a0) - FULL SET ----
190 T$ = "A2. CORRESPONDENCE  (ESC a0) - full":  GOSUB 9100
200 PRINT E$;"a0";: GOSUB 1000
210 PRINT E$;"a0";: GOSUB 2000
220 PRINT E$;"a0";: GOSUB 3000
230 REM ---- A3. NLQ (a2) ----
240 T$ = "A3. NEAR LETTER QUALITY  (ESC a2)":  GOSUB 9100
250 PRINT E$;"a2";: GOSUB 1000
260 PRINT E$;"a2";: GOSUB 2000
270 PRINT E$;"a2";: GOSUB 3500
280 PRINT "(half/script/custom -> force CORR in NLQ too)"
290 REM ---- A4. PROPORTIONAL SPACING SHOWCASE ----
300 T$ = "A4. PROPORTIONAL  (corr ESC p / NLQ ESC P)":  GOSUB 9100
310 PRINT E$;"a0";E$;"p";: GOSUB 1000
320 PRINT "CORR PROP PACKS TIGHT: illili WWMM jiff";E$;"N"
330 PRINT E$;"a2";E$;"P";: GOSUB 1000
340 PRINT "NLQ PROP: the quick brown fox jumps a lazy dog";E$;"N";E$;"a0"
350 REM ====== BLOCK B: CROSS-CUTTING (font-orthogonal) ======
360 REM ---- B1. PITCHES / CPI ----
370 T$ = "B1. PITCHES / CPI  (same text)":  GOSUB 9100
380 P$ = "ImageWriter II 12345":  PRINT E$;"a0";
390 PRINT E$;"N";"Extended  (n): ";E$;"n";P$
400 PRINT E$;"N";"Pica  10  (N): ";E$;"N";P$
410 PRINT E$;"N";"Elite 12  (E): ";E$;"E";P$
420 PRINT E$;"N";"Semicond. (e): ";E$;"e";P$
430 PRINT E$;"N";"Condensed (q): ";E$;"q";P$
440 PRINT E$;"N";"Ultracond.(Q): ";E$;"Q";P$
450 PRINT E$;"N";"Prop-Pica (p): ";E$;"p";P$
460 PRINT E$;"N";"Prop-Elite(P): ";E$;"P";P$
470 PRINT E$;"N";
480 REM ---- B2. COLOUR BANDS + OVERPRINT MIX ----
490 T$ = "B2. COLOUR BANDS  (ESC K 0-6)":  GOSUB 9100
500 PRINT E$;"a0";
510 PRINT E$;"K0";"K0 BLACK ";E$;"K1";"K1 YELLOW ";E$;"K2";"K2 RED ";E$;"K3";"K3 BLUE"
520 PRINT E$;"K4";"K4 ORANGE ";E$;"K5";"K5 GREEN ";E$;"K6";"K6 PURPLE";E$;"K0"
530 PRINT : PRINT "OVERPRINT MIX (band over band, same dot):"
540 X$ = "MIX"
550 PRINT "Y+B: ";: PRINT E$;"K1";X$;: GOSUB 2500: PRINT E$;"K3";X$;E$;"K0";"  -> green"
560 PRINT "Y+R: ";: PRINT E$;"K1";X$;: GOSUB 2500: PRINT E$;"K2";X$;E$;"K0";"  -> orange"
570 PRINT "R+B: ";: PRINT E$;"K2";X$;: GOSUB 2500: PRINT E$;"K3";X$;E$;"K0";"  -> purple"
580 PRINT "(needs colour ribbon installed to show colour)"
590 REM ---- B3. LINE SPACING ----
600 T$ = "B3. LINE SPACING  (A=6LPI / B=8LPI)":  GOSUB 9100
610 PRINT E$;"a0";E$;"A";"6 LPI line one"
620 PRINT "6 LPI line two"
630 PRINT E$;"B";"8 LPI line one"
640 PRINT "8 LPI line two";E$;"A"
650 REM ---- B4. PRINT DIRECTION ----
660 T$ = "B4. DIRECTION  (< bidir / > unidir)":  GOSUB 9100
670 PRINT E$;"a0";E$;"<";"Bidirectional (default): ";S$
680 PRINT E$;">";"Unidirectional (cleaner): ";S$;E$;"<"
690 REM ---- B5. MOUSETEXT ----
700 T$ = "B5. MOUSETEXT  (ESC & maps $40-$5F)":  GOSUB 9100
710 PRINT E$;"a0";
720 FOR R = 0 TO 3:S = 64 + R * 8
730 PRINT E$;"$";"KEYS: ";: FOR I = S TO S + 7: PRINT  CHR$ (I);" ";: NEXT I: PRINT
740 PRINT E$;"$";"GLPH: ";E$;"&";: FOR I = S TO S + 7: PRINT  CHR$ (I);" ";: NEXT I: PRINT E$;"$": PRINT
750 NEXT R
760 REM ====== COUT MATRIX DONE ======
770 GOSUB 9000
780 PRINT E$;"a0";E$;"!";"--- END OF COUT MATRIX ---";E$;Q$
790 PRINT : PRINT
800 REM ====== BLOCK C: CUSTOM DOWNLOADED FONTS ======
810 REM DRIVEN VIA DIRECT-ACIA POKE (NOT PR#2 COUT).
820 REM COUT EATS THE CTRL-D DOWNLOAD TERMINATOR AND
830 REM MASKS THE HIGH BIT, SO WE STREAM RAW BYTES TO
840 REM 49320 ($C0A8) WITH A READ/POKE DATA LOOP BELOW.
850 REM LATEX MATH GAG: SENTENCE WITH INLINE SIGMA + A
860 REM DISPLAY-STYLE SUM (INFINITY / SIGMA / I=1) AND
870 REM A 1/I FRACTION, ALL FROM DOWNLOADED CUSTOM GLYPHS.
880 PRINT D$;"PR#2"
890 PRINT E$;"a0";E$;"!";"C. CUSTOM FONT: LATEX MATH SET (SIGMA / INFINITY / FRACTION)";E$;Q$
900 PRINT : PRINT
910 PRINT D$;"PR#0": REM COUT BACK ON SCREEN; STREAM POKES ACIA DIRECT
920 PRINT "CUSTOM-FONT SECTION: STREAMING MATH SET TO ACIA..."
930 RESTORE
940 READ B: IF B < 0 THEN 970
950 POKE A,B: GOTO 940
970 PRINT "DONE. MATH SET PRINTED + FORM FEED SENT."
975 PRINT D$;"SAVE IMAGEWRITERII/TEXT.TEST"
980 END
1000 REM == FULL PRINTABLE ASCII (CURRENT FONT) ==
1010 FOR R = 0 TO 2:S = 32 + R * 32:F = S + 31: IF F > 126 THEN F = 126
1020 L$ = "": FOR I = S TO F:L$ = L$ +  CHR$ (I): NEXT I
1030 PRINT L$
1040 NEXT R
1050 RETURN
