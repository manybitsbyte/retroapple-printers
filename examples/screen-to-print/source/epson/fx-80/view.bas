10  REM  README VIEWER - SCREEN TO PRINT
20 D$ =  CHR$ (4)
30 F$ = "/SCREEN.TO.PRINT/EPSON/FX.80/README"
40  DIM A$(200)
50  TEXT : HOME
60  ONERR  GOTO 300
70  PRINT D$;"OPEN ";F$
80  PRINT D$;"READ ";F$
90 N = 0:L$ = ""
100  GET C$:C =  ASC (C$)
110  IF C = 13 THEN A$(N) = L$:N = N + 1:L$ = "": GOTO 100
120 L$ = L$ + C$
130  GOTO 100
300  POKE 216,0: PRINT D$;"CLOSE"
310  HOME :LC = 0
320  FOR I = 0 TO N - 1
330  PRINT A$(I)
340 LC = LC + 1: IF LC < 22 THEN 380
350  INVERSE : PRINT " -SPACE=MORE  ESC=QUIT- ";: NORMAL
360  GET K$: IF K$ =  CHR$ (27) THEN 390
370  HOME :LC = 0
380  NEXT I
390  PRINT : PRINT "[END OF README]"
400  END
