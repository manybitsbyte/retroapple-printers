20  REM  IMAGEWRITER II - LO-RES COLOUR
30  REM  SHAPE TEST (DUMP, PAGE 1)
40  REM  COMPANION B TO IMAGEWRITER-II-
50  REM  TEST.BAS / .ASM - DRAWS AN
60  REM  INTERESTING 16-HUE FIGURE FOR
70  REM  THE COLOUR SCREEN DUMP.
80  REM ================================
90  GR
100  FOR Y = 0 TO 47
110  FOR X = 0 TO 39
120  P =  ABS (X - 20) *  ABS (Y - 24)
130  COLOR= P - 16 *  INT (P / 16)
140  PLOT X,Y
150  NEXT X
160  NEXT Y
170  REM ---- WHITE REGISTRATION FRAME ----
180  COLOR= 15
190  HLIN 0,39 AT 0: HLIN 0,39 AT 47
200  VLIN 0,47 AT 0: VLIN 0,47 AT 39
210  END
