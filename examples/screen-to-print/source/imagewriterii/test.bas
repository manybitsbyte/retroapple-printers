10 REM ================================
20 REM  IMAGEWRITER II - PRINT TEST
30 REM  6 PAGES: PITCH STYLE FONT COLOR
40 REM  PAGES 4-5 NEED A COLOR RIBBON
50 REM ================================
60 D$ = CHR$ (4):E$ = CHR$ (27):F$ = CHR$ (12)
70 B1$ = E$ + "!":B0$ = E$ +  CHR$ (34): REM BOLD ON/OFF
80 U1$ = E$ + "X":U0$ = E$ + "Y": REM UNDERLINE
90 W1$ =  CHR$ (14):W0$ =  CHR$ (15): REM DOUBLE WIDTH
100 H1$ = E$ + "w":H0$ = E$ + "W": REM HALF HEIGHT
110  DIM C$(6): FOR I = 0 TO 6:C$(I) = E$ + "K" +  STR$ (I): NEXT
120  PRINT D$;"PR#2"
130  GOSUB 1000: REM PITCHES
140  GOSUB 2000: REM STYLES
150  GOSUB 3000: REM FONTS
160  GOSUB 4000: REM COLOR BARS
170  GOSUB 5000: REM COLOR + STYLE
180  GOSUB 6000: REM FILL / RULER
190  PRINT D$;"PR#0"
200  END
1000  REM ---- PAGE 1: PITCHES ----
1010  PRINT "=== PAGE 1: CHARACTER PITCHES ==="
1020  PRINT E$;"N";"PICA      10.0 CPI  ABCDEFG abcdefg 012345"
1030  PRINT E$;"E";"ELITE     12.0 CPI  ABCDEFG abcdefg 012345"
1040  PRINT E$;"e";"SEMICOND  13.4 CPI  ABCDEFG abcdefg 012345"
1050  PRINT E$;"q";"CONDENSED 15.0 CPI  ABCDEFG abcdefg 012345"
1060  PRINT E$;"Q";"ULTRACOND 17.0 CPI  ABCDEFG abcdefg 012345"
1070  PRINT E$;"n";"EXTENDED   9.0 CPI  ABCDEFG abc 012"
1080  PRINT E$;"N"
1090  FOR I = 1 TO 8: PRINT "  PICA BODY FILLER LINE ";I: NEXT
1100  PRINT F$;: RETURN
2000  REM ---- PAGE 2: STYLES ----
2010  PRINT "=== PAGE 2: TYPE STYLES ==="
2020  PRINT "PLAIN ROMAN - THE QUICK BROWN FOX"
2030  PRINT B1$;"BOLD DOUBLE-STRIKE TEXT";B0$
2040  PRINT U1$;"UNDERLINED TEXT SAMPLE";U0$
2050  PRINT B1$;U1$;"BOLD + UNDERLINE TOGETHER";U0$;B0$
2060  PRINT W1$;"DOUBLE WIDTH";W0$;" THEN NORMAL"
2070  PRINT H1$;"HALF HEIGHT TEXT SAMPLE";H0$
2080  PRINT "BASE ";E$;"x";"SUPER";E$;"z";" ";E$;"y";"SUB";E$;"z";" BASE"
2090  FOR I = 1 TO 8: PRINT "  STYLE FILLER LINE ";I: NEXT
2100  PRINT F$;: RETURN
3000  REM ---- PAGE 3: FONTS ----
3010  PRINT "=== PAGE 3: PRINT QUALITY ==="
3020  PRINT E$;"a1";"DRAFT  - FAST  - ABCDEFG abcdefg 012345"
3030  PRINT E$;"m";"CORRESP - ABCDEFG abcdefg 012345"
3040  PRINT E$;"M";"NLQ    - BEST  - ABCDEFG abcdefg 012345"
3050  PRINT E$;"a1"
3060  FOR I = 1 TO 8: PRINT "  DRAFT FILLER LINE ";I: NEXT
3070  PRINT F$;: RETURN
4000  REM ---- PAGE 4: COLOR BARS ----
4010  PRINT C$(0);"=== PAGE 4: COLOR RIBBON ==="
4020  PRINT C$(1);"YELLOW  1111111111111111111111"
4030  PRINT C$(2);"RED     2222222222222222222222"
4040  PRINT C$(3);"BLUE    3333333333333333333333"
4050  PRINT C$(4);"ORANGE  4444444444444444444444"
4060  PRINT C$(5);"GREEN   5555555555555555555555"
4070  PRINT C$(6);"PURPLE  6666666666666666666666"
4080  PRINT C$(0);"BLACK   0000000000000000000000"
4090  FOR I = 1 TO 6: PRINT C$(I);"  COLOR FILLER ";I: NEXT
4095  PRINT C$(0);F$;: RETURN
5000  REM ---- PAGE 5: COLOR + STYLE ----
5010  PRINT C$(0);"=== PAGE 5: COLOR + STYLE ==="
5020  PRINT C$(2);B1$;"BOLD RED HEADLINE";B0$;C$(0)
5030  PRINT C$(3);U1$;"UNDERLINED BLUE";U0$;C$(0)
5040  PRINT C$(5);W1$;"BIG GREEN";W0$;C$(0)
5050  PRINT C$(6);"PURPLE ";C$(4);"ORANGE ";C$(1);"YELLOW";C$(0)
5060  FOR I = 1 TO 6: PRINT C$(I);"  RAINBOW ROW ";I;" ==============": NEXT
5070  PRINT C$(0);F$;: RETURN
6000  REM ---- PAGE 6: FILL / RULER ----
6010  PRINT "=== PAGE 6: PAGE FILL ==="
6020  PRINT E$;"q";"0----+----1----+----2----+----3----+----4----+----5"
6030  PRINT E$;"N"
6040  FOR I = 1 TO 40: PRINT "LINE ";I;" OF PAGE 6 - BODY TEXT FILLING THE FORM": NEXT
6050  PRINT F$;: RETURN
